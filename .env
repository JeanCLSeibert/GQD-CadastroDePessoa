#!/bin/bash
export DB_HOST="localhost"
export DB_PORT="3307"
read -s -p "Senha:" password
export DB_USER="root"
export DB_PASSWORD=$password
export DB_NAME="cadastro"
export TESTE_DB_HOST=$DB_HOST
export TESTE_DB_PORT=$DB_PORT
export TESTE_DB_USER=$DB_USER
export TESTE_DB_PASSWORD=$DB_PASSWORD
export TESTE_DB_NAME="cadastro_teste"